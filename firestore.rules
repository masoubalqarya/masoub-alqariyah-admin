rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Customers (mobile/website) have no staff profile. Guard get() so a missing
    // users/{uid} doc does not fail the whole rule evaluation.
    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: Get user role from Firestore users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: Check if user is an admin
    function isAdmin() {
      return userExists() && getUserRole() == 'admin';
    }

    // Helper: Check if user is a cashier
    function isCashier() {
      return userExists() && getUserRole() == 'cashier';
    }

    // Helper: Get cashier's restaurant ID (only call after isCashier())
    function getCashierRestaurant() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId;
    }

    // Users collection - Admin full access, staff can read own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Employee attendance roster - independent of staff login accounts
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    // Immutable raw events and device heartbeats are written server-side only
    match /attendanceEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /attendanceDevices/{deviceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Attendance configuration and manager corrections are admin-only.
    match /shiftTemplates/{shiftId} {
      allow read, write: if isAdmin();
    }

    match /attendanceSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // The prayer provider and manual adjustment endpoint write with server credentials.
    match /prayerTimes/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /attendanceOverrides/{overrideId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.employeeId is string &&
        request.resource.data.shiftDate is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() > 0 &&
        request.resource.data.adjustedBy == request.auth.uid;
      allow delete: if false;
    }

    // Categories - Admin full access, public read for mobile app
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu Items - Admin full access, public read for mobile app
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Size Options - Admin full access, public read for mobile app
    match /sizeOptions/{sizeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Extras Options - Admin full access, public read for mobile app
    match /extrasOptions/{extraId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Allergies Options - Admin full access, public read for mobile app
    match /allergiesOptions/{allergyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offers - Admin full access, public read for mobile app
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Restaurants - Admin full access, public read for mobile app
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer profiles — written by mobile/website on full-account sign-up.
    // Not the same as staff `users/{uid}`.
    match /customers/{customerId} {
      allow read, create, update: if isAuthenticated() && request.auth.uid == customerId;
      allow delete: if isAdmin();
    }

    // Orders - Admin full access, cashier read/update own restaurant orders.
    // Authenticated customers (including anonymous guests) can create orders.
    // The creating customer can read their own order for track/history.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isCashier() && resource.data.restaurantId == getCashierRestaurant()) ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin() ||
        (isCashier() && resource.data.restaurantId == getCashierRestaurant());
      allow delete: if isAdmin();
    }
  }
}
