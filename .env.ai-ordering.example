# Server-only. Copy the variables into .env.local; do not commit real values.
AI_ORDERING_ENABLED=false
AI_ORDERING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_ORDERING_TEXT_MODEL=gpt-5.4-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Recommended for the initial pilot: comma-separated Firebase customer/guest UIDs.
AI_ORDERING_ALLOWED_UIDS=
# Browser/Expo web origins only; native clients authenticate with Firebase ID tokens.
AI_ORDERING_ALLOWED_ORIGINS=http://localhost:8081
# Shared paid initialization/text request ceiling across all users, UTC day.
AI_ORDERING_DAILY_REQUEST_LIMIT=500
# Reuse the admin app's existing server credentials; never use NEXT_PUBLIC_ here.
FIREBASE_SERVICE_ACCOUNT_BASE64=
