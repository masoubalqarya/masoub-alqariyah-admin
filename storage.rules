rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Allow admin users full access to all storage paths
    match /menuItems/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /offers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /restaurants/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
